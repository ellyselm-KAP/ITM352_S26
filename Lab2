# Ask the user to enter their birth year. Calculate their 
# age based on current year (2026) and print it out 
# Name: Ellyse McChesney 
# Date: Jan. 20, 2026

birth_year = input("Please enter your numeric birth year: ")
birth_year_int = int(birth_year)
current_year = 2026
age = current_year - birth_year_int
print("You were born in " + str(birth_year_int))
print("Your age is: " + str(age))
